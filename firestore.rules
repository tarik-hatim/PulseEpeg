rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'plan', 'isPremium', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'plan', 'isPremium', 'createdAt', 'updatedAt']) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 80 &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 160 &&
        data.plan is string &&
        (data.plan == 'free' || data.plan == 'pro') &&
        data.isPremium is bool &&
        ((data.plan == 'pro' && data.isPremium == true) || (data.plan == 'free' && data.isPremium == false)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserSettings(data, userId) {
      return data.keys().hasAll(['user_id', 'selected_bouquets', 'favorite_channels', 'is_premium', 'created_at', 'updated_at']) &&
        data.keys().hasOnly(['user_id', 'selected_bouquets', 'favorite_channels', 'is_premium', 'created_at', 'updated_at']) &&
        data.user_id is string &&
        data.user_id.size() >= 1 &&
        data.user_id.size() <= 128 &&
        data.user_id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.user_id == userId &&
        data.user_id == request.auth.uid &&
        data.is_premium is bool &&
        data.selected_bouquets is list &&
        data.selected_bouquets.size() >= 1 &&
        data.selected_bouquets.size() <= 25 &&
        ((data.is_premium == false && data.selected_bouquets.size() <= 3) || (data.is_premium == true && data.selected_bouquets.size() <= 25)) &&
        data.favorite_channels is list &&
        data.favorite_channels.size() <= 200 &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'plan', 'isPremium', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'plan', 'isPremium', 'updatedAt'])
        );

      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /user_settings/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserSettings(incoming(), userId) &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time;

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserSettings(incoming(), userId) &&
        incoming().user_id == existing().user_id &&
        incoming().created_at == existing().created_at &&
        incoming().updated_at == request.time &&
        (
          // Action 1: Sync selected_bouquets and/or favorite_channels
          incoming().diff(existing()).affectedKeys().hasOnly(['selected_bouquets', 'favorite_channels', 'is_premium', 'updated_at']) ||
          // Action 2: Sync only selected_bouquets
          incoming().diff(existing()).affectedKeys().hasOnly(['selected_bouquets', 'updated_at']) ||
          // Action 3: Sync only favorite_channels
          incoming().diff(existing()).affectedKeys().hasOnly(['favorite_channels', 'updated_at'])
        );

      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
